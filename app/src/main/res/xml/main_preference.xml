<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <PreferenceCategory android:title="Профиль">

        <EditTextPreference
            android:key="name_key"
            android:title="Имя"
            app:icon="@drawable/ic_settings"
            app:summary="Ваше имя" />

        <EditTextPreference
            android:key="weight_key"
            android:title="Вес"
            app:icon="@drawable/ic_settings"
            app:summary="Ваш вес" />

        <ListPreference
            android:defaultValue="met"
            android:entries="@array/calorie_formula_name"
            android:entryValues="@array/calorie_formula_value"
            android:key="calorie_formula_key"
            android:title="Метод расчета калорий"
            app:icon="@drawable/ic_settings"
            app:summary="Выберите алгоритм подсчета энергозатрат" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/location">

        <ListPreference
            android:defaultValue="3000"
            android:entries="@array/location_time_update_name"
            android:entryValues="@array/location_time_update_value"
            android:key="update_time_key"
            android:title="@string/update_time"
            app:icon="@drawable/update_time"
            app:summary="@string/update_time_summary" />

        <ListPreference
            android:defaultValue="#03A9F4"
            android:entries="@array/color_name"
            android:entryValues="@array/color_value"
            android:key="color_key"
            android:title="@string/track_color"
            app:icon="@drawable/ic_circle"
            app:summary="@string/track_color_summary" />
    </PreferenceCategory>

    <PreferenceCategory android:title="Данные и карты">

        <Preference
            android:key="download_map_key"
            android:title="Оффлайн-карты"
            android:icon="@android:drawable/ic_menu_save"
            app:summary="Загрузить область карты для работы без интернета" />

        <Preference
            android:key="import_gpx_key"
            android:title="Импортировать маршрут (GPX)"
            android:icon="@android:drawable/ic_menu_add"
            app:summary="Добавить маршрут из файла на устройстве" />

        <Preference
            android:key="export_csv_key"
            android:title="Экспорт всех тренировок в CSV"
            app:icon="@android:drawable/ic_menu_share"
            app:summary="Сохранить все данные в файл" />

    </PreferenceCategory>

</PreferenceScreen>